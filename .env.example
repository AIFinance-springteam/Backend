# Copy this file to .env and fill in the blank values.
DB_URL=jdbc:mysql://localhost:3306/aifinance?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=aifinance
DB_PASSWORD=

MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=
# Use the same value as DB_PASSWORD so Spring can connect to the Compose database.
MYSQL_PASSWORD=

JWT_SECRET=

# Keep CLOVA credentials empty until an actual OCR call is intentionally tested.
CLOVA_OCR_INVOKE_URL=
CLOVA_OCR_SECRET_KEY=
